@startuml 核心类
skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  HeaderBackgroundColor #E8EEF7
}

class MonitorController {
  {static} MAX_MONITORS = 5
  - _monitors : dict[str, MonitorSession]
  - _order : list[str]
  - _active_id : str
  - _interval : int
  - _reports / _documents : dict
  + state(since, monitor_id) : dict
  + create() : dict
  + start(monitor_id, source, interval, align_clock) : dict
  + stop(monitor_id) : dict
  + remove(monitor_id) : dict
  + select(monitor_id) : dict
  + set_interval(interval) : dict
  + update_settings(...) : dict
  + report_document(bvid) : dict
}

class MonitorSession {
  + monitor_id : str
  - _state : idle｜running｜stopped
  - _samples : list[dict]
  - _interval : int
  - _next_due : float  «monotonic»
  - _align_clock : bool
  - _stop_event : Event
  + prepare(source, interval) : dict
  + begin(prepared, align_clock) : dict
  + stop() : dict
  + set_interval(interval) : dict
  + snapshot(since) : dict
  + context() : dict
  + cooldown_remaining() : float
  - _loop()
  - _sample_once(scheduled_ms)
  - _record_failure(message)
}

class BiliClient {
  {static} MIN_REQUEST_GAP = 0.15s
  {static} COOLDOWN_SECONDS = 90
  - _cooldown_until : float
  - _cookie : str
  + resolve(source) : VideoRef
  + fetch_snapshot(ref) : (VideoInfo, dict)
  + cooldown_remaining() : float
  - _get(path, params)
  - _fetch_online(bvid, cid)
  - _enter_cooldown() / _restore_cooldown()
}

class Settings {
  - _data : {auto_save, auto_save_dir, align_clock}
  + update(...) : dict
  + as_dict() : dict
  + auto_save_enabled() : bool
}

class VideoRef {
  bvid : str
  aid : int
}

class VideoInfo {
  bvid / aid / title / owner
  cover / duration / cid / url
}

class CollectError {
  message : str
  kind : throttled｜input｜network｜error
  retry_after : int
}

MonitorController "1" o-- "0..5" MonitorSession : 管理
MonitorController --> BiliClient : 探测与冷却查询
MonitorController --> Settings
MonitorSession --> BiliClient : 采样
BiliClient ..> VideoRef : 产出
BiliClient ..> VideoInfo : 产出
BiliClient ..> CollectError : 抛出
@enduml
