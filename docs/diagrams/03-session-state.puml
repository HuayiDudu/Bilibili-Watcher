@startuml 会话状态
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
}

state "idle\n未绑定视频" as idle
state "running\n采样线程运行中" as running
state "stopped\n已冻结，样本保留" as stopped

[*] --> idle : create() 新建监控槽位
idle --> running : begin(prepared)\n绑定视频并起线程
stopped --> running : begin(prepared)\n重新开始（样本清零）
running --> running : 每周期采样\n成功 success+1\n失败 failure+1
running --> stopped : stop()\n产出报告
idle --> [*] : remove()
stopped --> [*] : remove()\n（报告仍保留可下载）

note right of running
  采样失败不终止会话，
  只累加 failure_count 并记录 last_error
end note

note bottom of stopped
  有样本才产出报告；
  未开自动保存时只留在内存
end note
@enduml
